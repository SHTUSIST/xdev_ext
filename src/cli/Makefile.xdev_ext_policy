CC ?= gcc
CLANG ?= clang
BPFTOOL ?= bpftool
VMLINUX_BTF ?= /sys/kernel/btf/vmlinux
BUILD_DIR ?= .xdev_ext-policy-build

CFLAGS ?= -O2 -g
CFLAGS += -std=gnu11 -Wall -Wextra -Werror
LDLIBS += -lbpf -lelf -lz -pthread

BPF_ARCH ?= x86
BPF_MULTIARCH ?= $(shell $(CC) -dumpmachine)
BPF_CFLAGS ?= -O2 -g -Wall -Wextra -Werror -target bpf \
	-D__TARGET_ARCH_$(BPF_ARCH) \
	-I/usr/include/$(BPF_MULTIARCH)

BPF_SOURCE := xdev_ext_reference_policy.bpf.c
BPF_OBJECT := $(BUILD_DIR)/xdev_ext_reference_policy.bpf.o
LOADER_SOURCE := xdev_ext_reference_policy.c
LOADER := $(BUILD_DIR)/xdev_ext_reference_policy
BTF_DUMP := $(BUILD_DIR)/target-vmlinux.btf.raw

.DEFAULT_GOAL := all

all: $(BPF_OBJECT) $(LOADER)

loader: $(LOADER)

bpf: $(BPF_OBJECT)

$(BUILD_DIR):
	mkdir -p $@

$(BTF_DUMP): $(VMLINUX_BTF) | $(BUILD_DIR)
	@set -eu; \
	temporary="$@.tmp"; \
	trap 'rm -f "$$temporary"' EXIT; \
	$(BPFTOOL) btf dump file $(VMLINUX_BTF) format raw >"$$temporary"; \
	grep -q "STRUCT 'xdev_ext_binding_ops'" "$$temporary"; \
	grep -q "FUNC 'bpf_xdev_ext_dispatch_action'" "$$temporary"; \
	grep -q "FUNC 'bpf_xdev_ext_complete_action'" "$$temporary"; \
	mv -f "$$temporary" "$@"

$(BPF_OBJECT): $(BPF_SOURCE) xdev_ext_reference_policy_abi.h $(BTF_DUMP) | $(BUILD_DIR)
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

$(LOADER): $(LOADER_SOURCE) xdev_ext_reference_policy_core.h \
		xdev_ext_reference_policy_abi.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) $< -o $@ $(LDFLAGS) $(LDLIBS)

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all bpf clean loader
