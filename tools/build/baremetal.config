# SPDX-License-Identifier: GPL-2.0
# Bare-metal deployment fragment: merge onto a distribution base config, run
# olddefconfig, then `python3 tools/build/baremetal.py check-config .config`.
# Every device route is enabled in one kernel; tools/build/baremetal.py holds
# the accepted values the checker enforces on the final .config.

# Modules, BTF and BPF.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_IO_URING=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# xdev_ext mechanism layer and classes.
CONFIG_IO_URING_XDEV_EXT_BPF_POLICY=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_XDEV_EXT_POLICY=y
CONFIG_XDEV_EXT_MECH=y
CONFIG_XDEV_EXT_MECH_CE=y
CONFIG_XDEV_EXT_MECH_DMA=y
CONFIG_XDEV_EXT_MECH_ZEROCOPY=y
# CONFIG_XDEV_EXT_MECH_KVM_BOUNCE is not set
CONFIG_XDEV_EXT_MECH_SOCKET=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_XDEV_EXT_PEER_DMABUF=y

# Upstream PCI P2PDMA and its x86_64 dependencies (device-BAR admission).
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_MIGRATION=y
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_ZONE_DEVICE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_P2PDMA=y

# IOMMUs of both x86 vendors.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# NVMe is built in, as in every tested guest profile.
CONFIG_BLK_DEV_NVME=y

# Intel E800 NIC; XDP and AF_XDP zero copy are part of the ice driver.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_ICE=m

# USB4/Thunderbolt and the host-to-host class (tristate, follows USB4).
CONFIG_USB4=m
CONFIG_XDEV_EXT_MECH_XDOMAIN=m

# A self-built kernel cannot use distribution signing-key paths.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_LOCALVERSION="-xdev-ext-bm"
# CONFIG_LOCALVERSION_AUTO is not set
