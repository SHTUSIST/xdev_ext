static int class_bind(struct xdev_ext_mech_stage *st,const struct xdev_ext_mech_stage_uapi *u)
{ int saved=distance; if((int)st->index==refuse_stage)distance=-1;
 int ret=xdev_ext_requester_bind(&st->rq,st,&requester,u->flags);distance=saved;
 st->priv=&st->rq; observed_caps=st->caps;return ret; }
