static void record_free(void *p) { if(p==allocated){session_frees++;refs_at_free=((struct xdev_ext_mech_session *)p)->ss.refs;inflight_at_free=((struct xdev_ext_mech_session *)p)->ss.inflight;freed_with_custody=((struct xdev_ext_mech_session *)p)->ss.inflight!=0 || ((struct xdev_ext_mech_session *)p)->ss.refs!=1;allocated=NULL;memset(p,0xa5,sizeof(struct xdev_ext_mech_session));}free(p); }
