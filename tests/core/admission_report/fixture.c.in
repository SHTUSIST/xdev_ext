 INIT_LIST_HEAD(&s->ring_node);INIT_LIST_HEAD(&s->all_node);INIT_LIST_HEAD(&s->live_node);INIT_LIST_HEAD(&s->free);
 xdev_ext_mech_sess_init(&s->ss);s->ss.state=XDEV_EXT_MECH_SESSION_NONE; }
