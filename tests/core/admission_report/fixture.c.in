/* RELEASE */
static bool xdev_ext_mech_ready(void) { return true; }
static int copy_from_user(void *d,const void *s,size_t n) { if(s==read_fault)return 1;memcpy(d,s,n);return 0; }
static int copy_to_user(void *d,const void *s,size_t n) {
 copyouts++;
 if(n==496 && allocated) {
  struct xdev_ext_mech_batch *b=xdev_ext_mech_batch_get_locked(allocated);
  admission_attempts++;
  if(IS_ERR(b))copyout_admission_ret=PTR_ERR(b);
  else {copyout_admission_ret=0;admission_accepted++;}
  if(stop_during_copyout){xdev_ext_mech_sess_stop(&allocated->ss);allocated->last_err=-ENOLINK;}
 }
 if(n==496 && allocated && (allocated->progress_ready || ring.xdev_ext_mech_sessions.next!=&ring.xdev_ext_mech_sessions))bad_report_publication=true;
 if(write_fault)return 1;
 memcpy(d,s,n);return 0;
}
#define put_user(v,p) (write_fault ? 1 : (*(p)=(v),0))
