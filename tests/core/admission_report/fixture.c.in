/* BATCH_GET */
static void publish_step_probe(struct list_head *node,struct list_head *head)
{
 (void)head;
 if(!publication_probe || !allocated ||
    (node!=&allocated->ring_node && node!=&allocated->all_node && node!=&allocated->live_node))return;
 publication_steps++;
 struct xdev_ext_mech_batch *b=xdev_ext_mech_batch_get_locked(allocated);
 if(!IS_ERR(b) || PTR_ERR(b)!=-ESHUTDOWN)bad_partial_admission=true;
}
static void xdev_ext_mech_session_stop(struct xdev_ext_mech_session *s,int e) { xdev_ext_mech_sess_stop(&s->ss);if(!s->last_err)s->last_err=e; }
