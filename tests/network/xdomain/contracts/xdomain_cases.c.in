/* SPDX-License-Identifier: GPL-2.0 */
/* Expectations come from frozen §4.7/4.7d K01–K10, not implementation. */
#define ASSERT(condition) do { \
	if (!(condition)) { \
		fprintf(stderr, "FAIL %s:%d: %s\n", __func__, __LINE__, #condition); \
		exit(1); \
	} \
} while (0)

/* The prototype itself is part of the sized-buffer ABI: typed-struct or
 * pointer-return substitutions must fail compilation. */
_Static_assert(__builtin_types_compatible_p(__typeof__(&bpf_xdev_ext_xdomain_info),
	int (*)(const struct xdev_ext_mech_ctx *, void *, u32)), "info uses void * + __sz");
_Static_assert(__builtin_types_compatible_p(__typeof__(&bpf_xdev_ext_xdomain_verdict),
	int (*)(const struct xdev_ext_mech_ctx *, const void *, u32)), "verdict uses const void * + __sz");

static struct xdev_ext_mech_session session, inner_session;
static struct xdev_ext_mech_stage stage, inner_stage;
static struct xdev_ext_mech_batch batch;
static struct xdev_ext_nvme_mech_ops ops, inner_ops;
static struct xdev_ext_binding_ctx_v2 base;
static struct xdev_ext_mech_call_args args;
static struct xdev_ext_xdomain_proto_info snapshot;
static struct xdev_ext_xdomain_proto_result result;
static struct xdev_ext_mech_frame frame;
static u8 backing[512];
static u32 out_length;
static unsigned callbacks;
static u32 variant, size_arg;
static const struct xdev_ext_mech_ctx *outer_ctx;
static void *guard;
static size_t guard_len;
static struct {
	u64 group, epoch;
	u32 protocol_state, posted, sent, released, published;
} private_state, private_before;

static void setup(xdev_ext_mech_cb_t callback)
{
	memset(&session, 0, sizeof(session));
	memset(&stage, 0, sizeof(stage));
	memset(&result, 0, sizeof(result));
	memset(&snapshot, 0, sizeof(snapshot));
	memset(&base, 0, sizeof(base));
	memset(&private_state, 0, sizeof(private_state));
	memset(&args, 0, sizeof(args));
	memset(backing, 0xa7, sizeof(backing));
	ops = (struct xdev_ext_nvme_mech_ops) {
		.prepare = callback, .build = callback, .complete = callback, .compute = callback,
	};
	session.id = 17;
	session.layout = (struct xdev_ext_mech_layout) {
		.frame_size = 65536, .hdr_room = 64, .seg_len = 32768, .group_bytes = 65536,
	};
	session.frames = 2;
	session.ops[XDEV_EXT_MECH_CLASS_XDOMAIN] = &ops;
	stage.s = &session; stage.class_id = XDEV_EXT_MECH_CLASS_XDOMAIN;
	stage.direction = XDEV_EXT_MECH_DIR_FROM_DEVICE; stage.priv = &private_state;
	private_state.group = 333; private_state.epoch = 44;
	private_before = private_state;
	base.abi_version = XDEV_EXT_BINDING_ABI_VERSION;
	base.ctx_size = sizeof(base); base.backend = XDEV_EXT_BINDING_BACKEND_UNSPEC;
	base.direction = stage.direction;
	snapshot.size = 256; snapshot.version = 1;
	snapshot.event = XDEV_EXT_XDP_EV_RTS; snapshot.direction = stage.direction;
	snapshot.event_id = 0x1122334455667788ULL; snapshot.epoch = 0x8877665544332211ULL;
	snapshot.pool_generation = 23; snapshot.local_inc = 29; snapshot.remote_inc = 31;
	snapshot.stream = 41; snapshot.now_ns = 500; snapshot.hard_deadline_ns = 900;
	snapshot.data_seq = 45; snapshot.expected_seq = 45;
	snapshot.facts = XDEV_EXT_XDP_F_LINK_UP | XDEV_EXT_XDP_F_ADMITS;
	snapshot.total_len = 8192; snapshot.count = 2;
	snapshot.want_len = 8192; snapshot.want_count = 2;
	snapshot.ctl_room = 1;
	for (u32 i = 0; i < sizeof(snapshot.tag); i++) snapshot.tag[i] = (u8)(i + 1);
	args.member = XDEV_EXT_MECH_MEMBER_COMPLETE;
	args.callsite = XDEV_EXT_MECH_SITE_WORKER_PROTOCOL;
	args.base = &base; args.info = &snapshot; args.info_size = 256;
	args.xdomain = &result;
	callbacks = 0;
}

static struct xdev_ext_xdomain_proto_verdict intent(void)
{
	/* Initialized writable local record, as required by __sz verification. */
	return (struct xdev_ext_xdomain_proto_verdict) {
		.size = 64, .version = 1, .action = XDEV_EXT_XDP_ACT_WAIT,
		.event_id = snapshot.event_id, .epoch = snapshot.epoch, .wake_ns = 600,
	};
}

static int invoke(s32 *ret)
{
	return xdev_ext_mech_call(&stage, &args, ret, NULL);
}

static void no_effects(void)
{
	ASSERT(!memcmp(&private_state, &private_before, sizeof(private_state)));
	ASSERT(stage.s == &session && stage.priv == &private_state);
	ASSERT(!private_state.posted && !private_state.sent && !private_state.released &&
	       !private_state.published && !private_state.protocol_state);
}

static struct xdev_ext_mech_call *real_call(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = xdev_ext_mech_call_of(ctx);
	ASSERT(c && &c->ctx == ctx && c->s == &session && c->st == &stage);
	ASSERT((ctx->member == XDEV_EXT_MECH_MEMBER_PREPARE ? !preempt_depth : !!preempt_depth) && !spin_depth);
	callbacks++;
	return c;
}

static s32 copy_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct { u64 before; struct xdev_ext_xdomain_proto_info value; u64 after; } dst;
	struct xdev_ext_xdomain_proto_verdict v = intent(), saved;
	struct xdev_ext_xdomain_proto_info snap_before = snapshot;

	memset(&dst, 0xa7, sizeof(dst));
	ASSERT(bpf_xdev_ext_xdomain_info(ctx, &dst.value, 256) == 0);
	ASSERT(dst.before == 0xa7a7a7a7a7a7a7a7ULL && dst.after == dst.before);
	ASSERT(!memcmp(&dst.value, &snapshot, 256));
	for (u32 i = 0; i < 4; i++) ASSERT(!dst.value.reserved[i]);
	ASSERT(!dst.value.group && !dst.value.state && !dst.value.remote);
	ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) == 0);
	saved = v;
	ASSERT(result.calls == 1 && !memcmp(&result.verdict, &saved, 64));
	memset(&v, 0xcc, sizeof(v));
	ASSERT(!memcmp(&result.verdict, &saved, 64));
	ASSERT(!memcmp(&snapshot, &snap_before, 256));
	ASSERT(!c->protocol_error);
	no_effects();
	return 0;
}

static s32 denied_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_xdomain_proto_info dst = {};
	struct xdev_ext_xdomain_proto_info before = dst;
	struct xdev_ext_xdomain_proto_verdict v = intent();

	ASSERT(bpf_xdev_ext_xdomain_info(ctx, &dst, sizeof(dst)) < 0);
	ASSERT(!memcmp(&dst, &before, sizeof(dst)));
	ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, sizeof(v)) < 0);
	ASSERT(c->protocol_error && result.calls == 0);
	no_effects();
	return 0; /* Ignoring errors must not hide them from real invoke. */
}

static s32 size_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_xdomain_proto_info dst = {}, before = dst;
	struct xdev_ext_xdomain_proto_verdict v = intent();

	if (!variant) {
		ASSERT(bpf_xdev_ext_xdomain_info(ctx, &dst, size_arg) < 0);
		ASSERT(!memcmp(&dst, &before, sizeof(dst)));
		/* A subsequent valid recording cannot erase an info misuse latch. */
		(void)bpf_xdev_ext_xdomain_verdict(ctx, &v, 64);
	} else {
		ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, size_arg) < 0);
		ASSERT(result.calls == 1);
		ASSERT(result.verdict.action == 0);
		ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) == -EALREADY);
		ASSERT(result.verdict.action == 0);
	}
	ASSERT(c->protocol_error);
	no_effects();
	return 0;
}

static s32 duplicate_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_xdomain_proto_verdict v = intent(), saved;

	if (variant) v.action = 0;
	int first = bpf_xdev_ext_xdomain_verdict(ctx, &v, 64);
	ASSERT(variant ? first < 0 : first == 0);
	ASSERT(result.calls == 1);
	saved = result.verdict;
	v = intent(); v.action = XDEV_EXT_XDP_ACT_IGNORE; v.wake_ns = 0;
	ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) == -EALREADY);
	ASSERT(!memcmp(&result.verdict, &saved, 64));
	ASSERT(c->protocol_error);
	no_effects();
	return 0;
}

static s32 malformed_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_xdomain_proto_verdict v = intent();

	switch (variant) {
	case 0: v.action = 0; break;
	case 1: v.action = 18; break;
	case 2: v.action = (u32)-1; break;
	case 3: v.version = 2; break;
	case 4: v.flags = 1; break;
	case 5: v.reserved0 = 1; break;
	case 6: v.reserved1 = 1; break;
	case 7: v.size = 63; break;
	case 8: v.size = 65; break;
	case 9: v.version = 0; break;
	case 10: v.event_id++; break;
	case 11: v.epoch++; break;
	default: abort();
	}
	ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) < 0);
	ASSERT(c->protocol_error && result.calls == 1 && result.verdict.action == 0);
	no_effects();
	return 0;
}

static s32 foreign_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx), copied = *c;
	struct xdev_ext_mech_ctx lone = *ctx;
	struct xdev_ext_xdomain_proto_info dst = {}, before = dst;
	struct xdev_ext_xdomain_proto_verdict v = intent();
	const struct xdev_ext_mech_ctx *bad;

	switch (variant) {
	case 0: bad = NULL; break;
	case 1: bad = (const void *)((const u8 *)guard + 1); break;
	case 2: bad = &copied.ctx; break;
	case 3: bad = &lone; break;
	case 4: bad = guard; break;
	default: abort();
	}
	if (size_arg) ASSERT(bpf_xdev_ext_xdomain_verdict(bad, &v, 64) == -EINVAL);
	else ASSERT(bpf_xdev_ext_xdomain_info(bad, &dst, 256) == -EINVAL);
	ASSERT(!memcmp(&dst, &before, 256));
	ASSERT(c->protocol_error && !copied.protocol_error && !result.calls);
	no_effects();
	return 0;
}

static s32 inner_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = xdev_ext_mech_call_of(ctx);
	struct xdev_ext_xdomain_proto_verdict v = intent();
	struct xdev_ext_xdomain_proto_result before = result;

	ASSERT(c && ctx != outer_ctx && ctx->class_id == XDEV_EXT_MECH_CLASS_NVME);
	ASSERT(c->st == &inner_stage && c->s == &inner_session && !c->xdomain);
	ASSERT(bpf_xdev_ext_xdomain_verdict(variant ? outer_ctx : ctx, &v, 64) < 0);
	ASSERT(c->protocol_error && !memcmp(&result, &before, sizeof(result)));
	return 0;
}

static s32 nested_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_mech_call_args nested = { .member = XDEV_EXT_MECH_MEMBER_COMPLETE,
		.callsite = XDEV_EXT_MECH_SITE_WORKER, .base = &base };
	struct xdev_ext_xdomain_proto_verdict v = intent();
	s32 ret = -999;
	unsigned depth = preempt_depth;

	outer_ctx = ctx;
	memset(&inner_session, 0, sizeof(inner_session));
	inner_ops = (struct xdev_ext_nvme_mech_ops) { .complete = inner_callback };
	inner_session.id = 71; inner_session.ops[XDEV_EXT_MECH_CLASS_NVME] = &inner_ops;
	inner_stage = (struct xdev_ext_mech_stage) { .s = &inner_session,
		.class_id = XDEV_EXT_MECH_CLASS_NVME };
	ASSERT(xdev_ext_mech_call(&inner_stage, &nested, &ret, NULL) == -EPROTO);
	ASSERT(ret == 0 && preempt_depth == depth);
	ASSERT(xdev_ext_mech_call_of(ctx) == c && !c->protocol_error);
	ASSERT(!result.calls && bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) == 0);
	ASSERT(result.calls == 1 && result.verdict.epoch == snapshot.epoch);
	no_effects();
	return 0;
}

static s32 no_batch_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	struct xdev_ext_xdomain_proto_info dst = {};
	struct xdev_ext_xdomain_proto_verdict v = intent();

	ASSERT(ctx->class_id == 11 && ctx->session_id == 17 && !ctx->batch_id);
	ASSERT(!ctx->nr_frames && !ctx->desc_cap && !ctx->base.src_offset && !ctx->base.length);
	ASSERT(!c->b && !c->frames && !c->nr_frames && !c->scratch && !c->desc_size && !c->desc_cap);
	ASSERT(!c->cqe && !c->cqe_size && !c->cqe_cap && !c->out_len && !c->len_delta);
	/* Geometry describes the real session; it grants no frame backing. */
	ASSERT(c->frame_size == 65536 && c->hdr_room == 64 && c->batch_frames == 2);
	ASSERT(!bpf_xdev_ext_info(ctx, 256));
	ASSERT(!bpf_xdev_ext_desc(ctx, 0, 64));
	ASSERT(!bpf_xdev_ext_cqe(ctx, 0, 64));
	ASSERT(!bpf_xdev_ext_frame(ctx, 0, 0, 1));
	ASSERT(bpf_xdev_ext_xdomain_info(ctx, &dst, 256) == 0);
	ASSERT(!memcmp(&dst, &snapshot, 256));
	ASSERT(!dst.group && !dst.state && !dst.remote);
	ASSERT(bpf_xdev_ext_xdomain_verdict(ctx, &v, 64) == 0);
	ASSERT(!c->protocol_error);
	no_effects();
	return 0;
}

static s32 never_callback(const struct xdev_ext_mech_ctx *ctx)
{
	(void)ctx; callbacks++;
	return 123;
}

static s32 ordinary_callback(const struct xdev_ext_mech_ctx *ctx)
{
	struct xdev_ext_mech_call *c = real_call(ctx);
	ASSERT(ctx->callsite == XDEV_EXT_MECH_SITE_WORKER);
	ASSERT(bpf_xdev_ext_info(ctx, sizeof(backing)) == backing);
	ASSERT(bpf_xdev_ext_cqe(ctx, 0, 64) == backing);
	ASSERT(bpf_xdev_ext_frame(ctx, 0, 0, 1) == backing);
	ASSERT(!c->protocol_error);
	return 0;
}

static void expect_call(int expected)
{
	s32 raw = -999;
	ASSERT(invoke(&raw) == expected);
	ASSERT(raw == 0 && callbacks == 1 && !preempt_depth && !spin_depth);
	ASSERT(xdev_ext_mech_call_of(NULL) == NULL);
	no_effects();
}

static void k01(void)
{
	const u32 classes[] = { 11, 2, 3, 4, 5, 6, 7, 8, 9, 10 };
	for (u32 i = 0; i < sizeof(classes) / sizeof(classes[0]); i++) {
		setup(denied_callback); stage.class_id = classes[i];
		session.ops[classes[i]] = &ops;
		args.callsite = XDEV_EXT_MECH_SITE_WORKER; args.xdomain = NULL;
		expect_call(-EPROTO);
	}
	for (u32 member = XDEV_EXT_MECH_MEMBER_PREPARE; member <= XDEV_EXT_MECH_MEMBER_BUILD; member++) {
		setup(denied_callback); args.xdomain = NULL; args.member = member;
		args.callsite = member == XDEV_EXT_MECH_MEMBER_PREPARE ?
			XDEV_EXT_MECH_SITE_CREATE : XDEV_EXT_MECH_SITE_WORKER;
		if (member == XDEV_EXT_MECH_MEMBER_BUILD) {
			args.scratch = backing; args.desc_size = 64; args.desc_cap = 1;
		}
		/* PREPARE is sleepable; real_call's preemption assertion is
 		 * deliberately relaxed only by its member, below. */
		expect_call(-EPROTO);
	}
}

static void k03(void)
{
	const u32 info_sizes[] = {0, 255, 257}, verdict_sizes[] = {0, 63, 65};
	for (u32 which = 0; which < 2; which++)
		for (u32 i = 0; i < 3; i++) {
			setup(size_callback); variant = which;
			size_arg = which ? verdict_sizes[i] : info_sizes[i];
			expect_call(-EPROTO);
		}
}

static void k05(void)
{
	for (u32 i = 0; i < 2; i++) {
		setup(duplicate_callback); variant = i; expect_call(-EPROTO);
	}
}

static void k06(void)
{
	long page = sysconf(_SC_PAGESIZE);
	ASSERT(page > 0); guard_len = (size_t)page;
	guard = mmap(NULL, guard_len, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
	ASSERT(guard != MAP_FAILED);
	for (u32 helper = 0; helper < 2; helper++)
		for (u32 which = 0; which < 5; which++) {
			setup(foreign_callback); variant = which; size_arg = helper; expect_call(-EPROTO);
		}
	/* No active call: even an unreadable input identity must not be read. */
	struct xdev_ext_xdomain_proto_info dst = {}, before = dst;
	struct xdev_ext_xdomain_proto_verdict v = intent();
	ASSERT(bpf_xdev_ext_xdomain_info(guard, &dst, 256) == -EINVAL);
	ASSERT(bpf_xdev_ext_xdomain_verdict(guard, &v, 64) == -EINVAL);
	ASSERT(!memcmp(&dst, &before, 256));
	ASSERT(munmap(guard, guard_len) == 0);
}

static void k07(void)
{
	for (u32 i = 0; i < 2; i++) {
		setup(nested_callback); variant = i; expect_call(0);
	}
}

static void k08(void)
{
	setup(no_batch_callback); expect_call(0);
	setup(ordinary_callback); args.callsite = XDEV_EXT_MECH_SITE_WORKER;
	args.xdomain = NULL; args.info = backing; args.info_size = sizeof(backing);
	args.cqe = backing; args.cqe_size = 64; args.cqe_cap = 1;
	frame = (struct xdev_ext_mech_frame) { .kaddr = backing, .data_len = 1 };
	args.frames = &frame; args.nr_frames = 1;
	expect_call(0);
}

static void k09(void)
{
	for (u32 which = 0; which < 23; which++) {
		setup(never_callback);
		s32 raw = -999;
		switch (which) {
		case 0: args.b = &batch; break;
		case 1: args.frames = &frame; break;
		case 2: args.nr_frames = 1; args.frames = &frame; break;
		case 3: args.scratch = backing; break;
		case 4: args.desc_size = 1; break;
		case 5: args.desc_cap = 1; break;
		case 6: args.cqe = backing; break;
		case 7: args.cqe_size = 1; break;
		case 8: args.cqe_cap = 1; break;
		case 9: args.out_len = &out_length; break;
		case 10: args.len_delta = 1; break;
		case 11: args.xdomain = NULL; break;
		case 12: args.info = NULL; break;
		case 13: args.info_size = 255; break;
		case 14: snapshot.size = 255; break;
		case 15: snapshot.version = 2; break;
		case 16: args.batch_id = 1; break;
		case 17: stage.s = NULL; break;
		case 18: args.callsite = XDEV_EXT_MECH_SITE_WORKER; break;
		case 19: args.member = XDEV_EXT_MECH_MEMBER_BUILD; break;
		case 20: args.member = XDEV_EXT_MECH_MEMBER_PREPARE; break;
		case 21: base.length = 1; break;
		case 22: base.src_offset = 1; break;
		}
		ASSERT(invoke(&raw) == -EINVAL);
		ASSERT(!callbacks && raw == -999 && !result.calls && !preempt_depth);
		ASSERT(xdev_ext_mech_call_of(NULL) == NULL);
	}
	/* Direct invoke must reject call_active-like absence of real stage/session,
 	 * and target identity that disagrees with the actual real stage. */
	for (u32 which = 0; which < 7; which++) {
		setup(never_callback);
		struct xdev_ext_mech_target t = { .s = &session, .st = &stage,
			.class_id = 11, .session_id = 17, .frame_size = 65536,
			.hdr_room = 64, .batch_frames = 2 };
		s32 raw = -999;
		switch (which) {
		case 0: t.st = NULL; break;
		case 1: t.s = NULL; break;
		case 2: t.class_id = 3; break;
		case 3: t.session_id = 18; break;
		case 4: stage.s = &inner_session; break;
		case 5: t.batch = true; break;
		case 6: t.batch_id = 1; break;
		}
		ASSERT(xdev_ext_mech_invoke(&ops, &t, &args, &raw, NULL) == -EINVAL);
		ASSERT(!callbacks && raw == -999 && !result.calls && !preempt_depth);
	}
}

int main(int argc, char **argv)
{
	ASSERT(argc == 2);
	if (!strcmp(argv[1], "K01")) k01();
	else if (!strcmp(argv[1], "K02") || !strcmp(argv[1], "K04")) {
		setup(copy_callback); expect_call(0);
	} else if (!strcmp(argv[1], "K03")) k03();
	else if (!strcmp(argv[1], "K05")) k05();
	else if (!strcmp(argv[1], "K06")) k06();
	else if (!strcmp(argv[1], "K07")) k07();
	else if (!strcmp(argv[1], "K08")) k08();
	else if (!strcmp(argv[1], "K09")) k09();
	else if (!strcmp(argv[1], "K10")) {
		for (u32 i = 0; i < 12; i++) {
			setup(malformed_callback); variant = i; expect_call(-EPROTO);
		}
	} else return 2;
	printf("ok - %s production-slice contract (host environment only; no verifier/hardware verdict)\n", argv[1]);
	return 0;
}
