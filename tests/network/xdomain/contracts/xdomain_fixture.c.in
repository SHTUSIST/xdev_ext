/* Kernel environment only; production identity/invoke code is inserted below. */
#define _GNU_SOURCE
#include <errno.h>
#include <pthread.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>
#include "io_uring/xdev_ext_mech_core.h"
#include "io_uring/xdev_ext_mech_cpu_core.h"
typedef uint8_t u8;
typedef uint32_t u32;
typedef uint64_t u64;
typedef int32_t s32;
typedef int64_t s64;
#define __bpf_kfunc
/* Standard kernel compile environment, not protocol/identity behavior. */
#define fallthrough __attribute__((__fallthrough__))
#define MAX_ERRNO 4095
_Static_assert(MAX_ERRNO == XDEV_EXT_MECH_ERRNO_MAX, "kernel errno bound agrees with mechanism core");
#define likely(condition) __builtin_expect(!!(condition), 1)
#define unlikely(condition) __builtin_expect(!!(condition), 0)
#define READ_ONCE(value) (value)
#define WRITE_ONCE(value, next) ((value) = (next))
#define container_of(pointer, type, member) ((type *)((char *)(pointer) - offsetof(type, member)))
static _Thread_local unsigned int preempt_depth;
static _Thread_local unsigned int cpu_id;
static _Thread_local unsigned int spin_depth;
static _Thread_local bool task_context = true;
struct task_struct { unsigned int unused; };
static _Thread_local struct task_struct host_task;
#define current (&host_task)
static bool in_task(void) { return task_context; }
/* CPU and task identities are separate: two sleeping pthread tasks can share
 * CPU 0, and a task can migrate between the two emulated CPU slots. */
#define DEFINE_PER_CPU(type, name) type name[2]
#define this_cpu_read(name) (name[cpu_id])
#define this_cpu_write(name, value) do { \
	if (!preempt_depth) { \
		fprintf(stderr, "per-CPU publication without disabled preemption\n"); \
		abort(); \
	} \
	(name[cpu_id]) = (value); \
} while (0)
#define raw_cpu_read(name) this_cpu_read(name)
#define raw_cpu_write(name, value) this_cpu_write(name, value)
#define DEFINE_SPINLOCK(name) pthread_mutex_t name = PTHREAD_MUTEX_INITIALIZER
#define DEFINE_RAW_SPINLOCK(name) DEFINE_SPINLOCK(name)
#define spin_lock_irqsave(lock, flags) do { \
	(flags) = 0; \
	if (pthread_mutex_lock(lock)) abort(); \
	spin_depth++; \
} while (0)
#define spin_unlock_irqrestore(lock, flags) do { \
	(void)(flags); \
	if (!spin_depth) abort(); \
	spin_depth--; \
	if (pthread_mutex_unlock(lock)) abort(); \
} while (0)
#define raw_spin_lock_irqsave(lock, flags) spin_lock_irqsave(lock, flags)
#define raw_spin_unlock_irqrestore(lock, flags) spin_unlock_irqrestore(lock, flags)
struct hlist_node { struct hlist_node *next; struct hlist_node **pprev; };
struct hlist_head { struct hlist_node *first; };
/* One bucket deliberately forces collisions between distinct tasks. */
#define DEFINE_HASHTABLE(name, bits) struct hlist_head name[1]
static void host_hlist_add(struct hlist_node *node, struct hlist_head *head)
{
	node->next = head->first;
	if (node->next)
		node->next->pprev = &node->next;
	head->first = node;
	node->pprev = &head->first;
}
static void host_hlist_del(struct hlist_node *node)
{
	*node->pprev = node->next;
	if (node->next)
		node->next->pprev = node->pprev;
}
#define hash_add(table, node, key) do { \
	(void)(key); \
	host_hlist_add(node, &(table)[0]); \
} while (0)
#define hash_del(node) host_hlist_del(node)
#define hash_for_each_possible(table, object, member, key) \
	for (struct hlist_node *host_node = ((void)(key), (table)[0].first); \
	     host_node && ((object) = container_of(host_node, __typeof__(*(object)), member), 1); \
	     host_node = host_node->next)
static void preempt_disable(void) { preempt_depth++; }
static void preempt_enable(void)
{
	if (!preempt_depth) {
		fprintf(stderr, "unbalanced preempt_enable\n");
		abort();
	}
	preempt_depth--;
}
static _Thread_local unsigned int crc_calls;
static u32 crc32c(u32 seed, const void *bytes, size_t length)
{
	(void)bytes;
	crc_calls++;
	return seed ^ (u32)length;
}

