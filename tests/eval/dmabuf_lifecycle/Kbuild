obj-m += lifecycle_bench.o
# Build-time identities are reported by the module and verified by the runner.
ccflags-y += -DXB_BUILD_SHA='"$(shell git -C $(src) rev-parse HEAD)"'
ccflags-y += -DXB_LIFE_HASH='"$(shell sha256sum $(src)/../../../kernel/io_uring/xdev_ext_mech_lifecycle.h | cut -d' ' -f1)"'
