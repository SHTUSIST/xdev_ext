Compatibility edits of the BaM baseline for Linux >= 6.5 and GCC 13.

Upstream: https://github.com/ZaidQureshi/bam (commit not recorded at clone
time; find it with find_upstream_commit.sh and upstream.lock).  Apply from the
BaM repository root:  git apply bam-linux6-gcc13-compat.patch

  module/map.c    get_user_pages() lost its vmas argument in Linux 6.5
  module/pci.c    class_create() lost its owner argument in Linux 6.4
  include/freestanding/libcxx/include/type_traits
                  GCC 13 reserves __is_convertible as a built-in trait name;
                  the internal helper is renamed __libcpp_is_convertible

--- a/module/map.c
+++ b/module/map.c
@@ -147,8 +147,10 @@
 #elif LINUX_VERSION_CODE <= KERNEL_VERSION(4, 8, 17)
 #warning "Building for older kernel, not properly tested"
     retval = get_user_pages(map->vaddr, map->n_addrs, 1, 0, pages, NULL);
-#else
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 5, 0)
     retval = get_user_pages(map->vaddr, map->n_addrs, FOLL_WRITE, pages, NULL);
+#else
+    retval = get_user_pages(map->vaddr, map->n_addrs, FOLL_WRITE, pages);
 #endif
     if (retval <= 0)
     {
