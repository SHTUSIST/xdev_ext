#define _GNU_SOURCE
#include <pthread.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <assert.h>
#include <errno.h>
typedef uint32_t u32;
typedef uint64_t u64;
typedef unsigned char uuid_t;
#define BIT_ULL(n) (1ULL<<(n))
#define TBIP_HDR_SN_MASK 0xc0000000U
#define TBIP_HDR_SN_SHIFT 30
#define TBIP_LOGIN 1
#define TBIP_LOGOUT 2
#define TBNET_LOGIN_RETRIES 60
#define msecs_to_jiffies(n) (n)
#define netdev_dbg(...) ((void)0)
#define netdev_warn(...) ((void)0)
#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
struct work_struct { bool pending; };
struct delayed_work { struct work_struct work; };
struct device { void *data; };
struct net_device { bool running, detached; void *data; };
struct tb_protocol_handler { int unused; };
struct tb_xdomain { const uuid_t *local_uuid,*remote_uuid; u64 route; };
struct tb_service { struct device dev; void *data; };
struct ring { int unused; };
struct tbnet_ring { struct ring *ring; };
struct tbnet {
 struct net_device *dev; struct tb_xdomain *xd;
 struct tb_protocol_handler handler;
 pthread_mutex_t connection_lock;
 bool login_sent,login_received; unsigned login_retries;
 int remote_transmit_path, local_transmit_path,napi;
 struct delayed_work login_work;
 struct work_struct connected_work,disconnect_work;
 struct tbnet_ring rx_ring,tx_ring;
};
struct thunderbolt_ip_header { uuid_t initiator_uuid,target_uuid; u32 route_hi,route_lo,length_sn,command_id,type; };
struct thunderbolt_ip_login { struct thunderbolt_ip_header hdr; u32 transmit_path; };
static void *system_long_wq;
static pthread_mutex_t gate_lock=PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t gate_cond=PTHREAD_COND_INITIALIZER;
static bool entered,released,active,freed;
static pthread_t reader;
static struct tbnet *current;
static int pending_at_free, late_access;
static unsigned seq, netdev_unregistered, last_drain;
static bool uuid_equal(const uuid_t *a,const uuid_t *b) { return *a==*b; }
static void mutex_lock(pthread_mutex_t *m) { assert(!pthread_mutex_lock(m)); }
static void mutex_unlock(pthread_mutex_t *m) { assert(!pthread_mutex_unlock(m)); }
static void queue_work(void *q,struct work_struct *w) { if(freed) late_access++; w->pending=true; }
static void queue_delayed_work(void *q,struct delayed_work *w,unsigned delay) { queue_work(q,&w->work); }
static void cancel_work_sync(struct work_struct *w) { w->pending=false;last_drain=++seq; }
static void cancel_delayed_work_sync(struct delayed_work *w) { cancel_work_sync(&w->work); }
static bool netif_running(struct net_device *d) { return d->running; }
static void netif_device_detach(struct net_device *d) { d->detached=true; }
static void *netdev_priv(struct net_device *d) { if(freed)late_access++;return d->data; }
static struct tb_service *tb_to_service(struct device *d) { return container_of(d,struct tb_service,dev); }
static void *tb_service_get_drvdata(struct tb_service *s) { return s->data; }
static int response(void) {
 pthread_mutex_lock(&gate_lock);entered=true;pthread_cond_broadcast(&gate_cond);
 while(!released)pthread_cond_wait(&gate_cond,&gate_lock);
 pthread_mutex_unlock(&gate_lock);return 0;
}
static int tbnet_login_response(struct tbnet *n,u64 r,u32 s,u32 c) { return response(); }
static int tbnet_logout_response(struct tbnet *n,u64 r,u32 s,u32 c) { return response(); }
static void tb_unregister_protocol_handler(struct tb_protocol_handler *h) {
 if(active) {
  pthread_mutex_lock(&gate_lock);released=true;pthread_cond_broadcast(&gate_cond);pthread_mutex_unlock(&gate_lock);
  assert(!pthread_join(reader,NULL));active=false;
 }
}
static void stop_login(struct tbnet *n);
static void tbnet_tear_down(struct tbnet *n,bool logout) { stop_login(n); }
static void napi_disable(int *n) { }
static void tb_ring_free(struct ring *r) { }
static void tb_xdomain_release_out_hopid(struct tb_xdomain *x,int h) { }
static int tbnet_stop(struct net_device *d);
static void unregister_netdev(struct net_device *d) { if(d->running) { d->running=false;tbnet_stop(d); } netdev_unregistered=++seq; }
static int register_netdev(struct net_device *d) { return -ENOMEM; }
static unsigned pending(struct tbnet *n) { return n->login_work.work.pending+n->connected_work.pending+n->disconnect_work.pending; }
static void free_netdev(struct net_device *d) { pending_at_free=pending(d->data);freed=true; }
/* PRODUCTION */
static struct thunderbolt_ip_login packet;
static void *call_packet(void *unused) { int r=tbnet_handle_packet(&packet,sizeof(packet),current);assert(r==1);return NULL; }
int main(int argc,char **argv) {
 assert(argc==2); uuid_t local=1,remote=2;
 struct tb_xdomain xd={&local,&remote,42};
 struct net_device dev={.running=true};
 struct tbnet net={.dev=&dev,.xd=&xd,.connection_lock=PTHREAD_MUTEX_INITIALIZER};
 struct tb_service svc={.data=&net};dev.data=&net;current=&net;
 packet.hdr.initiator_uuid=remote;packet.hdr.target_uuid=local;packet.hdr.route_lo=42;
 packet.hdr.type=strstr(argv[1],"logout")?TBIP_LOGOUT:TBIP_LOGIN;
 if(!strcmp(argv[1],"normal-drain")) {
  net.login_work.work.pending=net.connected_work.pending=net.disconnect_work.pending=true;
  tbnet_remove(&svc);
 } else {
  if(!strncmp(argv[1],"probe",5))dev.running=false;
  active=true;assert(!pthread_create(&reader,NULL,call_packet,NULL));
  pthread_mutex_lock(&gate_lock);while(!entered)pthread_cond_wait(&gate_cond,&gate_lock);pthread_mutex_unlock(&gate_lock);
  if(!strncmp(argv[1],"remove",6))tbnet_remove(&svc);
  else if(!strncmp(argv[1],"suspend",7))assert(tbnet_suspend(&svc.dev)==0);
  else assert(probe_tail(&net)==-ENOMEM);
 }
 unsigned remaining=pending(&net);
 if(netdev_unregistered && last_drain<=netdev_unregistered) { fputs("missing final callback work barrier after unregister_netdev\n",stderr);return 1; }
 if(active || remaining || pending_at_free || late_access) {
  fprintf(stderr,"callback_active=%d pending=%u pending_at_free=%d late_access=%d\n",active,remaining,pending_at_free,late_access);return 1;
 }
 return 0;
}
